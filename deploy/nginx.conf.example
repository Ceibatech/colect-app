# Replace DOMAIN with the chosen hostname. If APP_HTTP_PORT changes, update
# proxy_pass too. Install as a new vhost; preserve the server's existing sites.
# Start with HTTP, then obtain HTTPS with: certbot --nginx -d DOMAIN
server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN;

    # Application document limit: 20 MiB; allow multipart framing overhead.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8300;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        # This nginx is the public edge: discard client-supplied forwarding IPs.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
