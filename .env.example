# GeoArchives-MULCV local development configuration
#
# 1. Start a MySQL/MariaDB database, for example with the README Docker command.
# 2. Copy this file to .env.local.
# 3. Replace AUTH_SECRET with a generated value:
#    openssl rand -base64 32

DATABASE_URL="mysql://mulcv_app:devpassword_app@localhost:3306/mulcv_archivage"
AUTH_SECRET="changeme-generate-a-random-secret-with-openssl-rand-base64-32"

# Document storage. Use "sharepoint" on the production server once Microsoft Graph is configured.
STORAGE_PROVIDER="local"
DOCUMENTS_STORAGE_PATH="./storage/documents"

# Microsoft Graph / SharePoint (server-side only; never prefix with NEXT_PUBLIC_).
# Preferred production mode: explicit drive/folder IDs with Sites.Selected.
# SHAREPOINT_SHARED_FOLDER_URL is a discovery fallback and requires broader
# Files.ReadWrite.All or Sites.ReadWrite.All application permission.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ITEM_ID=
SHAREPOINT_SHARED_FOLDER_URL=

# Final digital archive. SharePoint/local remains the intake storage; only
# validated, pre-indexed documents are copied to Alfresco.
ARCHIVE_STORAGE_PROVIDER=
ALFRESCO_API_URL=
ALFRESCO_USERNAME=
ALFRESCO_PASSWORD=
ALFRESCO_ROOT_NODE_ID=
ALFRESCO_WEB_URL=
ALFRESCO_NODE_TYPE="arc:archiveDocument"
ALFRESCO_CLASSIFICATION="INTERNAL"

# Transactional email (Resend). Keep the real API key out of Git.
# onboarding@resend.dev can only send to the Resend account owner; use a
# verified ceiba-analytics.com sender for real recipients.
RESEND_API_KEY=
EMAIL_FROM="GeoArchives-MULCV <no-reply@ceiba-analytics.com>"
APP_URL="http://127.0.0.1:3000"
