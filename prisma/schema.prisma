// ================================================================
// PRISMA SCHEMA — GeoArchives : collecte, numérisation, indexation
// et archivage
//
// Base cible : MySQL / MariaDB (port 3306)
// Provider ORM : Prisma 6.x (generator classique "prisma-client-js")
//
// Conventions :
// - Modèles en PascalCase (idiomatique Prisma/TS), tables mappées en
//   snake_case via @@map pour respecter exactement les noms de tables
//   demandés dans le cahier des charges (section 9).
// - Champs en camelCase, colonnes mappées en snake_case via @map.
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ================================================================
// RBAC — ROLES / PERMISSIONS
// ================================================================

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique // ADMIN | SUPERVISEUR | OPERATEUR | GESTIONNAIRE_TRANSFERT | VALIDATEUR_CEIBAC | VALIDATEUR_MINISTERE | FINANCE | PMO | EXECUTIF | CONSULTATION
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ================================================================
// UTILISATEURS / OPÉRATEURS
// ================================================================

model User {
  id             Int       @id @default(autoincrement())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  roleId         Int       @map("role_id")
  isActive       Boolean   @default(true) @map("is_active")
  sessionVersion Int       @default(1) @map("session_version")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  operateur                          Operateur?
  // Phase 16+ (§ affectation superviseur) : opérateurs dont ce user
  // (rôle SUPERVISEUR) a la charge — voir Operateur.supervisorId ci-dessous.
  supervisedOperateurs               Operateur[]                @relation("OperateurSupervisor")
  dossierHistory                     DossierHistory[]
  workflowTransitions                WorkflowTransition[]
  documentsUploaded                  Document[]                 @relation("DocumentUploadedBy")
  documentsPreIndexed                Document[]                 @relation("DocumentPreIndexedBy")
  documentIndexingRuns               DocumentIndexingRun[]      @relation("DocumentIndexingRunBy")
  documentIndexingJobs               DocumentIndexingJob[]      @relation("DocumentIndexingJobRequestedBy")
  qualityChecks                      QualityCheck[]
  anomaliesCorrected                 Anomalie[]                 @relation("AnomalieCorrigePar")
  imports                            Import[]
  exports                            Export[]
  auditLogs                          AuditLog[]
  notifications                      Notification[]
  passwordResetTokens                PasswordResetToken[]
  pmoSupervisorScopes                PmoSupervisorScope[]       @relation("PmoScopeOwner")
  pmoScopeMemberships                PmoSupervisorScope[]       @relation("PmoScopeSupervisor")
  financeRatesCreated                FinanceRate[]              @relation("FinanceRateCreatedBy")
  transferLotsCreated                TransferLot[]              @relation("TransferLotCreatedBy")
  transferLotsAuthorized             TransferLot[]              @relation("TransferLotAuthorizedBy")
  transferLotsCeibacValidated        TransferLot[]              @relation("TransferLotCeibacValidatedBy")
  transferMovementsCreated           TransferMovement[]         @relation("TransferMovementCreatedBy")
  transferMovementsCeibacValidated   TransferMovement[]         @relation("TransferMovementCeibacValidatedBy")
  transferMovementsMinistryValidated TransferMovement[]         @relation("TransferMovementMinistryValidatedBy")
  transferSignaturesCaptured         TransferSignature[]        @relation("TransferSignatureCapturedBy")
  transferTrackingPoints             TransferTrackingPoint[]    @relation("TransferTrackingCapturedBy")
  transferConvoyEvents               TransferConvoyEvent[]      @relation("TransferConvoyEventUser")
  convoyTrackerToken                 ConvoyTrackerToken?
  dossiersPrepared                   Dossier[]                  @relation("DossierPreparateur")
  dossiersConditioned                Dossier[]                  @relation("DossierConditionneur")
  reconditionnementSessions          ReconditionnementSession[]
  preparationPieceLines              PreparationPieceLine[]     @relation("PreparationPieceLinePreparedBy")
  emailReportSubscription            EmailReportSubscription?   @relation("EmailReportRecipient")
  emailReportSubscriptionsCreated    EmailReportSubscription[]  @relation("EmailReportCreatedBy")
  emailReportDeliveries              EmailReportDelivery[]      @relation("EmailReportDeliveryRecipient")
  emailReportDeliveriesTriggered     EmailReportDelivery[]      @relation("EmailReportDeliveryTriggeredBy")
  transferEmailDeliveries            TransferEmailDelivery[]    @relation("TransferEmailDeliveryRecipient")
  transferLotParticipations          TransferLotParticipant[]
  // Sites dont le compte est responsable (profil RESPONSABLE_SITE).
  responsibleSites                   UserSite[]

  @@index([roleId])
  @@map("users")
}

enum PasswordResetPurpose {
  RESET
  ACTIVATE
}

model PasswordResetToken {
  id        Int                  @id @default(autoincrement())
  userId    Int                  @map("user_id")
  tokenHash String               @unique @map("token_hash") @db.Char(64)
  purpose   PasswordResetPurpose @default(RESET)
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PmoSupervisorScope {
  id               Int      @id @default(autoincrement())
  pmoUserId        Int      @map("pmo_user_id")
  supervisorUserId Int      @map("supervisor_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  pmoUser    User @relation("PmoScopeOwner", fields: [pmoUserId], references: [id], onDelete: Cascade)
  supervisor User @relation("PmoScopeSupervisor", fields: [supervisorUserId], references: [id], onDelete: Cascade)

  @@unique([pmoUserId, supervisorUserId])
  @@index([supervisorUserId])
  @@map("pmo_supervisor_scopes")
}

model FinanceRate {
  id                   Int       @id @default(autoincrement())
  operatorPointValue   Decimal   @map("operator_point_value") @db.Decimal(14, 2)
  supervisorPointValue Decimal   @map("supervisor_point_value") @db.Decimal(14, 2)
  currency             String    @default("XOF") @db.Char(3)
  effectiveFrom        DateTime  @unique @map("effective_from")
  effectiveTo          DateTime? @map("effective_to")
  createdById          Int?      @map("created_by_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  createdBy User? @relation("FinanceRateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([effectiveFrom, effectiveTo])
  @@map("finance_rates")
}

enum TransferLotStatus {
  BROUILLON
  SOUMIS
  VALIDE_CEIBAC
  AUTORISE
  PARTIELLEMENT_SORTI
  EN_TRANSIT
  RECU_PARTIEL
  CHEZ_CEIBAC
  RETOUR_PARTIEL
  CLOTURE
  ANNULE
}

enum TransferItemStatus {
  PREVU
  SORTI
  RECU
  RETOURNE
}

enum TransferMovementType {
  SORTIE
  RECEPTION
  RETOUR
}

enum TransferParty {
  MINISTERE
  CEIBAC
  CEIBAC_VALIDATOR
}

enum TransferMovementStatus {
  SOUMIS_CEIBAC
  VALIDE_CEIBAC
  VALIDE_MINISTERE
  REJETE
}

enum TransferConditionStatus {
  CONFORME
  AVEC_RESERVES
  NON_CONFORME
}

enum TransferSealStatus {
  INTACTS
  ANOMALIE
  NON_APPLICABLE
}

// Dossier de garde d'un lot archivistique. Le lotissement foncier reste un
// référentiel distinct : un TransferLot décrit ici une opération physique de
// remise, de transport et de restitution de cartons.
model TransferLot {
  id                     Int               @id @default(autoincrement())
  reference              String            @unique
  sourceSiteId           Int               @map("source_site_id")
  sourceEntrepotId       Int?              @map("source_entrepot_id")
  destinationSiteId      Int               @map("destination_site_id")
  destinationEntrepotId  Int?              @map("destination_entrepot_id")
  status                 TransferLotStatus @default(BROUILLON)
  motif                  String?           @db.Text
  archiveSupport         String?           @map("archive_support") @db.VarChar(20)
  plannedRoute           String?           @map("planned_route") @db.Text
  transportMethod        String?           @map("transport_method") @db.VarChar(160)
  ceibaParticipants      String?           @map("ceiba_participants") @db.Text
  sdaParticipants        String?           @map("sda_participants") @db.Text
  riskAssessment         String?           @map("risk_assessment") @db.Text
  securityMeasures       String?           @map("security_measures") @db.Text
  plannedAt              DateTime?         @map("planned_at")
  submittedAt            DateTime?         @map("submitted_at")
  ceibacValidatedAt      DateTime?         @map("ceibac_validated_at")
  ceibacValidatedById    Int?              @map("ceibac_validated_by_id")
  ceibacSignatoryName    String?           @map("ceibac_signatory_name") @db.VarChar(120)
  ceibacSignatoryTitle   String?           @map("ceibac_signatory_title") @db.VarChar(120)
  ceibacSignatureData    String?           @map("ceibac_signature_data") @db.LongText
  authorizedAt           DateTime?         @map("authorized_at")
  approvalSignatoryName  String?           @map("approval_signatory_name")
  approvalSignatoryTitle String?           @map("approval_signatory_title")
  approvalSignatureData  String?           @map("approval_signature_data") @db.LongText
  createdById            Int               @map("created_by_id")
  authorizedById         Int?              @map("authorized_by_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  sourceSite          Site                     @relation("TransferSourceSite", fields: [sourceSiteId], references: [id])
  sourceEntrepot      Entrepot?                @relation("TransferSourceEntrepot", fields: [sourceEntrepotId], references: [id])
  destinationSite     Site                     @relation("TransferDestinationSite", fields: [destinationSiteId], references: [id])
  destinationEntrepot Entrepot?                @relation("TransferDestinationEntrepot", fields: [destinationEntrepotId], references: [id])
  createdBy           User                     @relation("TransferLotCreatedBy", fields: [createdById], references: [id])
  authorizedBy        User?                    @relation("TransferLotAuthorizedBy", fields: [authorizedById], references: [id])
  ceibacValidatedBy   User?                    @relation("TransferLotCeibacValidatedBy", fields: [ceibacValidatedById], references: [id], onDelete: SetNull)
  items               TransferLotItem[]
  movements           TransferMovement[]
  trackingPoints      TransferTrackingPoint[]
  convoyEvents        TransferConvoyEvent[]
  participants        TransferLotParticipant[]

  @@index([sourceSiteId, sourceEntrepotId])
  @@index([destinationSiteId, destinationEntrepotId])
  @@index([status])
  @@index([createdById])
  @@index([ceibacValidatedById])
  @@map("transfer_lots")
}

// Une ligne représente un carton physique identifié. Les dossiers liés sont
// figés au moment de la constitution du lot pour conserver la preuve de son
// contenu même si l'inventaire évolue ensuite.
// Rattachement d'un responsable de site à ses sites : il remet les cartons qui
// en partent et fait l'état des lieux de ceux qui y arrivent.
model UserSite {
  userId    Int      @map("user_id")
  siteId    Int      @map("site_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
  @@index([siteId])
  @@map("user_sites")
}

enum TransferParticipantSide {
  CEIBA
  SDA
}

// Intervenant désigné sur une opération, choisi parmi les comptes habilités.
// La mention imprimée reste le texte figé du lot (ceibaParticipants/sdaParticipants).
model TransferLotParticipant {
  id            Int                     @id @default(autoincrement())
  transferLotId Int                     @map("transfer_lot_id")
  userId        Int                     @map("user_id")
  side          TransferParticipantSide
  roleCode      String                  @map("role_code") @db.VarChar(64)
  createdAt     DateTime                @default(now()) @map("created_at")

  transferLot TransferLot @relation(fields: [transferLotId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([transferLotId, userId])
  @@index([userId])
  @@map("transfer_lot_participants")
}

model TransferLotItem {
  id                   Int                @id @default(autoincrement())
  transferLotId        Int                @map("transfer_lot_id")
  cartonId             Int?               @map("carton_id")
  cartonCode           String             @map("carton_code")
  cartonLabel          String?            @map("carton_label")
  dossierCountSnapshot Int                @map("dossier_count_snapshot")
  status               TransferItemStatus @default(PREVU)
  departedAt           DateTime?          @map("departed_at")
  receivedAt           DateTime?          @map("received_at")
  returnedAt           DateTime?          @map("returned_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  transferLot   TransferLot            @relation(fields: [transferLotId], references: [id], onDelete: Cascade)
  carton        Carton?                @relation(fields: [cartonId], references: [id], onDelete: Restrict)
  dossiers      TransferLotDossier[]
  movementItems TransferMovementItem[]

  @@unique([transferLotId, cartonCode])
  @@index([cartonCode, status])
  @@index([cartonId])
  @@index([status])
  @@map("transfer_lot_items")
}

model TransferLotDossier {
  id                Int      @id @default(autoincrement())
  transferLotItemId Int      @map("transfer_lot_item_id")
  dossierId         Int      @map("dossier_id")
  createdAt         DateTime @default(now()) @map("created_at")

  transferLotItem TransferLotItem @relation(fields: [transferLotItemId], references: [id], onDelete: Cascade)
  dossier         Dossier         @relation(fields: [dossierId], references: [id])

  @@unique([transferLotItemId, dossierId])
  @@index([dossierId])
  @@map("transfer_lot_dossiers")
}

// Chaque mouvement est un bordereau immuable : la liste des cartons et les
// deux visas sont enregistrés dans la même transaction que le changement de
// garde, pour éviter un stock sans preuve ou une preuve sans mouvement.
model TransferMovement {
  id                    Int                      @id @default(autoincrement())
  transferLotId         Int                      @map("transfer_lot_id")
  reference             String                   @unique
  type                  TransferMovementType
  status                TransferMovementStatus   @default(VALIDE_MINISTERE)
  conditionStatus       TransferConditionStatus? @map("condition_status")
  vehicleRegistration   String?                  @map("vehicle_registration") @db.VarChar(80)
  vehicleDescription    String?                  @map("vehicle_description") @db.VarChar(160)
  driverName            String?                  @map("driver_name") @db.VarChar(120)
  driverPhone           String?                  @map("driver_phone") @db.VarChar(40)
  ceibaEscortName       String?                  @map("ceiba_escort_name") @db.VarChar(120)
  sealReferences        String?                  @map("seal_references") @db.Text
  sealStatus            TransferSealStatus?      @map("seal_status")
  incidentReported      Boolean                  @default(false) @map("incident_reported")
  incidentDescription   String?                  @map("incident_description") @db.Text
  occurredAt            DateTime                 @map("occurred_at")
  fromSiteId            Int                      @map("from_site_id")
  toSiteId              Int                      @map("to_site_id")
  observations          String?                  @db.Text
  createdById           Int                      @map("created_by_id")
  ceibacValidatedAt     DateTime?                @map("ceibac_validated_at")
  ceibacValidatedById   Int?                     @map("ceibac_validated_by_id")
  ministryValidatedAt   DateTime?                @map("ministry_validated_at")
  ministryValidatedById Int?                     @map("ministry_validated_by_id")
  createdAt             DateTime                 @default(now()) @map("created_at")

  transferLot         TransferLot            @relation(fields: [transferLotId], references: [id], onDelete: Cascade)
  fromSite            Site                   @relation("TransferMovementFromSite", fields: [fromSiteId], references: [id])
  toSite              Site                   @relation("TransferMovementToSite", fields: [toSiteId], references: [id])
  createdBy           User                   @relation("TransferMovementCreatedBy", fields: [createdById], references: [id])
  ceibacValidatedBy   User?                  @relation("TransferMovementCeibacValidatedBy", fields: [ceibacValidatedById], references: [id], onDelete: SetNull)
  ministryValidatedBy User?                  @relation("TransferMovementMinistryValidatedBy", fields: [ministryValidatedById], references: [id], onDelete: SetNull)
  items               TransferMovementItem[]
  signatures          TransferSignature[]

  @@index([transferLotId, occurredAt])
  @@index([createdById])
  @@index([status])
  @@index([ceibacValidatedById])
  @@index([ministryValidatedById])
  @@map("transfer_movements")
}

model TransferMovementItem {
  id                Int                @id @default(autoincrement())
  movementId        Int                @map("movement_id")
  transferLotItemId Int                @map("transfer_lot_item_id")
  statusBefore      TransferItemStatus @map("status_before")
  statusAfter       TransferItemStatus @map("status_after")
  createdAt         DateTime           @default(now()) @map("created_at")

  movement        TransferMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  transferLotItem TransferLotItem  @relation(fields: [transferLotItemId], references: [id])

  @@unique([movementId, transferLotItemId])
  @@index([transferLotItemId])
  @@map("transfer_movement_items")
}

model TransferSignature {
  id             Int           @id @default(autoincrement())
  movementId     Int           @map("movement_id")
  party          TransferParty
  signatoryName  String        @map("signatory_name")
  signatoryTitle String        @map("signatory_title")
  signatureData  String        @map("signature_data") @db.LongText
  capturedById   Int           @map("captured_by_id")
  signedAt       DateTime      @map("signed_at")
  ipAddress      String?       @map("ip_address")
  createdAt      DateTime      @default(now()) @map("created_at")

  movement   TransferMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)
  capturedBy User             @relation("TransferSignatureCapturedBy", fields: [capturedById], references: [id])

  @@unique([movementId, party])
  @@index([capturedById])
  @@map("transfer_signatures")
}

// Jalons du convoi : départ (le convoyeur lance le suivi) et arrivée (bouton
// du convoyeur, ou détection automatique à l'approche du site d'arrivée). Ils
// déclenchent la notification des responsables des deux sites.
enum TransferConvoyEventType {
  DEPART
  ARRIVEE
}

model TransferConvoyEvent {
  id            Int                     @id @default(autoincrement())
  transferLotId Int                     @map("transfer_lot_id")
  type          TransferConvoyEventType
  userId        Int?                    @map("user_id")
  latitude      Float?
  longitude     Float?
  automatic     Boolean                 @default(false)
  // Fiche de départ : véhicule, chauffeur, scellés, cartons contrôlés.
  details       Json?
  occurredAt    DateTime                @default(now()) @map("occurred_at")

  transferLot TransferLot @relation(fields: [transferLotId], references: [id], onDelete: Cascade)
  user        User?       @relation("TransferConvoyEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([transferLotId, occurredAt])
  @@index([userId])
  @@map("transfer_convoy_events")
}

// Identifiant de l'application Traccar Client (gratuite) d'un convoyeur : elle
// envoie la position même écran éteint, au protocole OsmAnd, sur /api/osmand.
model ConvoyTrackerToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  token      String    @unique @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("convoy_tracker_tokens")
}

model TransferTrackingPoint {
  id            Int      @id @default(autoincrement())
  transferLotId Int      @map("transfer_lot_id")
  capturedById  Int      @map("captured_by_id")
  latitude      Float
  longitude     Float
  accuracy      Float?
  speed         Float?
  heading       Float?
  capturedAt    DateTime @map("captured_at")
  createdAt     DateTime @default(now()) @map("created_at")

  transferLot TransferLot @relation(fields: [transferLotId], references: [id], onDelete: Cascade)
  capturedBy  User        @relation("TransferTrackingCapturedBy", fields: [capturedById], references: [id])

  @@index([transferLotId, capturedAt])
  @@index([capturedById])
  @@map("transfer_tracking_points")
}

// NOTE ARCHITECTURE (choix technique documenté) :
// Une table `operateurs` séparée de `users` est conservée car le cahier
// des charges y fait référence explicitement comme clé étrangère sur
// dossiers/numerisations/indexations/archivages (section 9), et un
// opérateur métier (matricule, nom terrain) peut exister sans compte de
// connexion actif. La relation user_id reste optionnelle pour couvrir
// ce cas ; en usage normal 1 utilisateur OPERATEUR = 1 fiche opérateur.
model Operateur {
  id           Int      @id @default(autoincrement())
  userId       Int?     @unique @map("user_id")
  matricule    String   @unique
  nom          String
  prenoms      String?
  telephone    String?
  email        String?
  isActive     Boolean  @default(true) @map("is_active")
  // Phase 16+ : superviseur (User de rôle SUPERVISEUR) ayant la charge de
  // cet opérateur — un opérateur a au plus UN superviseur ; un superviseur
  // peut avoir plusieurs opérateurs ("groupe"). Nullable : un opérateur
  // peut rester non affecté (visible/validable par tout SUPERVISEUR tant
  // qu'aucune affectation n'existe n'est PAS le comportement — voir
  // access-scope.ts : un SUPERVISEUR ne voit/valide que ses affectations
  // explicites, jamais les opérateurs non affectés). Affectation gérée
  // depuis /administration/utilisateurs (édition d'un compte SUPERVISEUR).
  supervisorId Int?     @map("supervisor_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user       User? @relation(fields: [userId], references: [id])
  supervisor User? @relation("OperateurSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  dossiers      Dossier[]
  numerisations Numerisation[]
  indexations   Indexation[]
  archivages    Archivage[]

  @@index([supervisorId])
  @@map("operateurs")
}

// ================================================================
// RÉFÉRENTIELS
// ================================================================

model Commune {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  nom         String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lotissements Lotissement[]
  dossiers     Dossier[]
  sites        Site[]

  @@map("communes")
}

model Lotissement {
  id          Int      @id @default(autoincrement())
  communeId   Int      @map("commune_id")
  code        String   @unique
  nom         String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  commune  Commune   @relation(fields: [communeId], references: [id])
  dossiers Dossier[]

  @@index([communeId])
  @@map("lotissements")
}

model NatureDossier {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  libelle     String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dossiers Dossier[]

  @@map("natures_dossier")
}

enum SiteOrganisation {
  MINISTERE
  CEIBA
  AUTRE
}

// Type de pièce jointe au dossier (CNI, Carte résident, Extrait topo...) —
// liste fermée mais extensible : la Collecte (StepDossier.tsx) permet de
// sélectionner plusieurs types existants ET d'en ajouter un nouveau à la
// volée (saisie libre), résolu côté serveur en find-or-create comme pour
// Lotissement/NatureDossier "Autres". Relation many-to-many implicite avec
// Dossier (un dossier référence plusieurs types de pièces, un type de pièce
// est utilisé par plusieurs dossiers).
model TypePiece {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  libelle     String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dossiers         Dossier[]              @relation("DossierTypesPieces")
  documents        Document[]
  preparationLines PreparationPieceLine[]

  @@map("types_piece")
}

// Site d'archivage physique (siège, dépôt, antenne...) — Phase 16+. Choisi
// en première étape de la Collecte (avant Identification) : chaque dossier
// est rattaché au site où le carton est/sera physiquement conservé. Ordre
// des champs aligné sur la fiche "Informations générales du site" fournie
// par le métier. `code`/`nom`/`isActive`/`description` suivent la même
// convention que les autres référentiels (Commune, Lotissement,
// NatureDossier) ; `communeId` réutilise le référentiel `communes` existant
// (les exemples métier — "Cocody" — sont déjà dans les 201 communes
// importées) plutôt qu'un champ texte libre dupliqué.
model Site {
  id                Int              @id @default(autoincrement())
  code              String           @unique
  nom               String
  typeSite          String?          @map("type_site")
  organisation      SiteOrganisation @default(MINISTERE)
  description       String?          @db.Text
  isActive          Boolean          @default(true) @map("is_active")
  dateMiseEnService DateTime?        @map("date_mise_en_service")
  responsable       String?
  telephone         String?
  email             String?
  adresse           String?          @db.Text
  communeId         Int?             @map("commune_id")
  quartier          String?
  ville             String?
  region            String?

  // --- Géolocalisation (Phase 17+) --- capturée via le bouton "Capturer ma
  // position GPS" (Geolocation API du navigateur) dans le formulaire
  // d'administration du site. `adresseGps` est renseignée automatiquement
  // par géocodage inverse (OpenStreetMap/Nominatim, appelé côté serveur —
  // voir reverseGeocodeSite() dans referentiels-admin-service.ts), jamais
  // depuis le navigateur directement. `pointGps` est une représentation
  // texte pratique ("lat, lon") dérivée de latitude/longitude, pour copier-
  // coller vers un outil cartographique externe en attendant une carte
  // intégrée (§ hors périmètre V1, cf. DashboardGéographiquePage).
  latitude     Float?  @db.Double
  longitude    Float?  @db.Double
  altitude     Float?
  precisionGps Float?  @map("precision_gps")
  adresseGps   String? @map("adresse_gps") @db.Text
  pointGps     String? @map("point_gps")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  commune               Commune?           @relation(fields: [communeId], references: [id])
  dossiers              Dossier[]
  entrepots             Entrepot[]
  transferLotsFrom      TransferLot[]      @relation("TransferSourceSite")
  transferLotsTo        TransferLot[]      @relation("TransferDestinationSite")
  transferMovementsFrom TransferMovement[] @relation("TransferMovementFromSite")
  transferMovementsTo   TransferMovement[] @relation("TransferMovementToSite")
  responsibleUsers      UserSite[]

  @@index([communeId])
  @@map("sites")
}

// Entrepôt (Phase 17+) : un site d'archivage peut comprendre plusieurs
// entrepôts (bâtiments/salles de stockage distincts) — hiérarchie à deux
// niveaux, même principe que Commune -> Lotissement. Choisi dans la
// Collecte juste après le site (cascade), une fois qu'un site a été
// sélectionné.
model Entrepot {
  id                 Int     @id @default(autoincrement())
  siteId             Int     @map("site_id")
  code               String  @unique
  nom                String
  // Emplacement physique de la salle dans le site (bâtiment, tour, étage).
  // `nom` identifie la salle ; `localisation` permet de la retrouver sans
  // dupliquer un site pour chaque étage.
  localisation       String?
  typeEntrepot       String? @map("type_entrepot")
  description        String? @db.Text
  isActive           Boolean @default(true) @map("is_active")
  anneeMiseEnService Int?    @map("annee_mise_en_service")
  responsable        String?
  telephone          String?
  email              String?

  // --- Dimensions (Phase 17+) --- déclaratif, saisi une fois en
  // administration (ne varie pas d'une collecte à l'autre).
  surfaceM2            Float? @map("surface_m2")
  longueur             Float?
  largeur              Float?
  hauteurSousPlafond   Float? @map("hauteur_sous_plafond")
  nombreNiveaux        Int?   @map("nombre_niveaux")
  nombreSalles         Int?   @map("nombre_salles")
  nombreZonesArchivage Int?   @map("nombre_zones_archivage")

  // --- Capacité (Phase 17+) --- champs déclaratifs uniquement ; "capacité
  // occupée", "capacité disponible" et le taux d'occupation ne sont PAS
  // stockés : ils sont recalculés à la volée à partir du nombre réel de
  // cartons (dossiers.codeBarres renseigné) rattachés à cet entrepôt — voir
  // getEntrepotOccupancy() dans referentiels-admin-service.ts. Stocker une
  // valeur "occupée" figée se serait désynchronisé du réel dès le premier
  // dossier archivé/déplacé.
  nombreRayonnages   Int? @map("nombre_rayonnages")
  nombreTravees      Int? @map("nombre_travees")
  nombreEtageres     Int? @map("nombre_etageres")
  capaciteCartonsMax Int? @map("capacite_cartons_max")
  capaciteBoitesMax  Int? @map("capacite_boites_max")
  capaciteTheorique  Int? @map("capacite_theorique")

  // --- Conditions de conservation (Phase 17+) --- déclaratives, saisies/
  // mises à jour en administration au fil des relevés/contrôles.
  temperatureMoyenne         Float?   @map("temperature_moyenne")
  temperatureMin             Float?   @map("temperature_min")
  temperatureMax             Float?   @map("temperature_max")
  systemeClimatisation       Boolean? @map("systeme_climatisation")
  climatisationFonctionnelle Boolean? @map("climatisation_fonctionnelle")
  humiditeMoyenne            Float?   @map("humidite_moyenne")
  humiditeMin                Float?   @map("humidite_min")
  humiditeMax                Float?   @map("humidite_max")
  deshumidificateur          Boolean? @map("deshumidificateur")
  systemeControleHumidite    Boolean? @map("systeme_controle_humidite")
  protectionEau              Boolean? @map("protection_eau")
  protectionInfiltrations    Boolean? @map("protection_infiltrations")
  etancheiteBatiment         Boolean? @map("etancheite_batiment")
  protectionPoussiere        Boolean? @map("protection_poussiere")
  protectionNuisibles        Boolean? @map("protection_nuisibles")

  // --- Sécurité de l'entrepôt (Phase 17+) ---
  extincteursDisponibles       Boolean?  @map("extincteurs_disponibles")
  nombreExtincteurs            Int?      @map("nombre_extincteurs")
  detecteursFumee              Boolean?  @map("detecteurs_fumee")
  systemeAlarmeIncendie        Boolean?  @map("systeme_alarme_incendie")
  systemeExtinctionAutomatique Boolean?  @map("systeme_extinction_automatique")
  dateDernierControleIncendie  DateTime? @map("date_dernier_controle_incendie")
  dateProchainControleIncendie DateTime? @map("date_prochain_controle_incendie")
  gardiennage                  Boolean?  @map("gardiennage")
  videosurveillance            Boolean?  @map("videosurveillance")
  nombreCameras                Int?      @map("nombre_cameras")
  alarmeAntiIntrusion          Boolean?  @map("alarme_anti_intrusion")
  controleAcces                Boolean?  @map("controle_acces")
  badge                        Boolean?  @map("badge")
  serrureSecurisee             Boolean?  @map("serrure_securisee")
  registreVisiteurs            Boolean?  @map("registre_visiteurs")

  // --- Conditions d'accès (Phase 17+) --- "très important pour
  // l'application". `gardiennage`/`videosurveillance`/`registreVisiteurs`
  // ci-dessus couvrent déjà les items identiques de cette section (pas de
  // colonne dupliquée) ; `badgeNecessaire` et `controleIdentite` restent
  // distincts de `badge`/`controleAcces` (présence d'un équipement/système
  // vs. politique d'accès effective). Horaires et jours en texte libre
  // (pas de format imposé par le métier, ex. "Lundi-Vendredi").
  typeAcces              String?  @map("type_acces")
  accesLibre             Boolean? @map("acces_libre")
  autorisationNecessaire Boolean? @map("autorisation_necessaire")
  badgeNecessaire        Boolean? @map("badge_necessaire")
  controleIdentite       Boolean? @map("controle_identite")
  horaireOuverture       String?  @map("horaire_ouverture")
  horaireFermeture       String?  @map("horaire_fermeture")
  joursAcces             String?  @map("jours_acces")
  accesWeekend           String?  @map("acces_weekend")
  responsableAcces       String?  @map("responsable_acces")
  contactUrgence         String?  @map("contact_urgence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  site             Site          @relation(fields: [siteId], references: [id])
  dossiers         Dossier[]
  equipements      Equipement[]
  transferLotsFrom TransferLot[] @relation("TransferSourceEntrepot")
  transferLotsTo   TransferLot[] @relation("TransferDestinationEntrepot")

  @@index([siteId])
  @@map("entrepots")
}

// Équipement d'entrepôt (Phase 17+, "Équipements de l'entrepôt" — inventaire
// des équipements). Contrairement à Site/Commune/Lotissement/NatureDossier,
// un équipement n'est référencé par aucun dossier : c'est un inventaire de
// facilities propre à l'entrepôt, sans impact sur l'intégrité historique
// des dossiers. Suppression physique donc autorisée ici (seul référentiel
// de ce module à le permettre), contrairement aux autres qui se
// désactivent uniquement (§60).
model Equipement {
  id                       Int               @id @default(autoincrement())
  entrepotId               Int               @map("entrepot_id")
  type                     String
  reference                String?
  marque                   String?
  quantite                 Int?              @default(1)
  etat                     EtatConservation?
  dateAcquisition          DateTime?         @map("date_acquisition")
  dateDernierControle      DateTime?         @map("date_dernier_controle")
  dateProchaineMaintenance DateTime?         @map("date_prochaine_maintenance")
  observation              String?           @db.Text
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  entrepot Entrepot @relation(fields: [entrepotId], references: [id], onDelete: Cascade)

  @@index([entrepotId])
  @@map("equipements")
}

// ================================================================
// WORKFLOW (configuration + traçabilité des transitions)
// ================================================================

enum WorkflowType {
  COLLECTE
  VALIDATION
  PREPARATION
  NUMERISATION
  CONDITIONNEMENT
  INDEXATION
  ARCHIVAGE
}

model WorkflowStatus {
  id           Int          @id @default(autoincrement())
  workflowType WorkflowType @map("workflow_type")
  code         String
  libelle      String
  ordre        Int
  isFinal      Boolean      @default(false) @map("is_final")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@unique([workflowType, code])
  @@map("workflow_statuses")
}

model WorkflowTransition {
  id           Int          @id @default(autoincrement())
  dossierId    Int          @map("dossier_id")
  workflowType WorkflowType @map("workflow_type")
  fromStatus   String?      @map("from_status")
  toStatus     String       @map("to_status")
  userId       Int?         @map("user_id")
  commentaire  String?      @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([dossierId, workflowType])
  @@index([userId])
  @@map("workflow_transitions")
}

model DossierHistory {
  id            Int      @id @default(autoincrement())
  dossierId     Int      @map("dossier_id")
  userId        Int?     @map("user_id")
  action        String
  ancienStatut  String?  @map("ancien_statut")
  nouveauStatut String?  @map("nouveau_statut")
  commentaire   String?  @db.Text
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([dossierId, createdAt])
  @@index([userId])
  @@map("dossier_history")
}

// ================================================================
// DOSSIER — table centrale
// ================================================================

enum StatutCollecte {
  BROUILLON
  SOUMIS
}

enum StatutValidation {
  EN_ATTENTE
  EN_CONTROLE
  VALIDE
  REJETE
}

// Validation par exception : les contrôles automatiques cohérents atteignent
// directement TERMINE ; A_VALIDER est réservé aux anomalies qui nécessitent
// une décision du superviseur. REJETE permet une correction puis une nouvelle
// exécution automatique. TERMINE garde sa sémantique d'étape effectivement
// terminée et débloque immédiatement la suivante.
//
// Phase 20+ : nouvelle étape "Préparation", intercalée entre Validation et
// Numérisation (cycle complet désormais Collecte -> Validation ->
// Préparation -> Numérisation -> Indexation -> Archivage). Même forme que
// StatutNumerisation/StatutIndexation/StatutArchivage ci-dessous — l'
// opérateur y renseigne nombrePieces/typesPieces/nombrePages (retirés de la
// Collecte, cf. StepDossier.tsx/StepSuivi.tsx), le superviseur valide ou
// rejette. Pas de table dédiée (contrairement à numerisations/indexations/
// archivages) : comme Validation, qui n'a elle-même jamais eu de table
// propre, ce n'est qu'une porte de contrôle sur des champs déjà présents sur
// `Dossier` — une table ne s'imposait pas.
enum StatutPreparation {
  EN_ATTENTE
  EN_COURS
  A_VALIDER
  TERMINE
  REJETE
}

enum StatutNumerisation {
  EN_ATTENTE
  EN_COURS
  A_VALIDER
  TERMINE
  REJETE
}

// Réponse de l'agent à la fin du reconditionnement d'un dossier.
enum EtatRemiseDossier {
  ETAT_INITIAL
  AVEC_RESERVE
}

enum StatutConditionnement {
  EN_ATTENTE
  EN_COURS
  TERMINE
  REJETE
}

enum StatutIndexation {
  EN_ATTENTE
  EN_COURS
  A_VALIDER
  TERMINE
  REJETE
}

enum StatutArchivage {
  EN_ATTENTE
  EN_COURS
  A_VALIDER
  TERMINE
  REJETE
}

// Identité physique stable. Le code-barres et le libellé d'origine restent
// conservés sur les dossiers et sur les bordereaux historiques.
model Carton {
  id               Int               @id @default(autoincrement())
  // Clé technique d'admission concurrente, effacée lors d'un changement
  // d'emplacement/identification. Jamais utilisée comme référence publique.
  legacyKey        String?           @unique @map("legacy_key") @db.Char(64)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  dossiers         Dossier[]
  transferLotItems TransferLotItem[]

  @@map("cartons")
}

model Dossier {
  id       Int  @id @default(autoincrement())
  cartonId Int? @map("carton_id")

  // Référence unique générée automatiquement : DOS-2026-000001
  reference String @unique

  operateurId Int @map("operateur_id")

  // --- SITE (Phase 16+) --- Site d'archivage physique où le dossier est
  // collecté/conservé — choisi en première étape de la Collecte. Nullable :
  // optionnel pour l'instant, le référentiel `sites` étant vide à son
  // introduction (aucun site n'existe encore en production) — passera à
  // requis à la soumission une fois qu'au moins un site aura été créé par
  // un administrateur (cf. dossierSubmitSchema, src/lib/validation/dossier.ts).
  siteId     Int? @map("site_id")
  // Entrepôt (Phase 17+) : précision optionnelle du site, en cascade — un
  // site peut comprendre plusieurs entrepôts. Même raisonnement que siteId
  // ci-dessus : nullable, le référentiel `entrepots` étant vide au départ.
  entrepotId Int? @map("entrepot_id")

  // --- IDENTIFICATION (fiche CG1020) ---
  libelleCarton          String?           @map("libelle_carton")
  codeBarres             String?           @map("code_barres")
  numeroGuichet          String?           @map("numero_guichet")
  // Anciennement "N° DDU" — repurposé en "Direction/Service concerné(e)"
  // (liste fermée + "Autres" en saisie libre, cf. src/lib/validation/dossier.ts
  // DIRECTION_SERVICE_OPTIONS). Nom de colonne conservé (numero_ddu) pour
  // éviter une migration de renommage sur une colonne déjà en usage.
  numeroDdu              String?           @map("numero_ddu")
  numeroDirectionService String?           @map("numero_direction_service")
  referenceClassement    String?           @map("reference_classement")
  // État physique du carton constaté à la collecte (Phase 15+) ; description
  // uniquement pertinente si DEGRADE (non contrainte en base — l'UI ne
  // l'affiche que dans ce cas, cf. StepIdentification.tsx).
  etatCarton             EtatConservation? @map("etat_carton")
  etatCartonDescription  String?           @map("etat_carton_description") @db.Text

  // --- INFORMATIONS FONCIÈRES (fiche CG1020) ---
  numeroIlot         String?  @map("numero_ilot")
  numeroLot          String?  @map("numero_lot")
  superficie         Decimal? @db.Decimal(12, 2)
  numeroTitreFoncier String?  @map("numero_titre_foncier")

  communeId     Int? @map("commune_id")
  lotissementId Int? @map("lotissement_id")

  // --- DOSSIER (fiche CG1020) ---
  natureDossierId        Int?              @map("nature_dossier_id")
  // État physique du dossier constaté à la collecte (Phase 15+), même
  // principe que l'état du carton.
  etatDossier            EtatConservation? @map("etat_dossier")
  etatDossierDescription String?           @map("etat_dossier_description") @db.Text
  // Nombre de pièces contenues dans le dossier et liste des types de pièces
  // présentes (Phase 18+) — cf. fiche métier "Dossier". `typesPieces` est une
  // relation many-to-many vers le référentiel extensible `TypePiece`
  // (sélection multiple + ajout à la volée, résolu côté serveur) ;
  // `autresPieces` est un champ texte libre distinct, pour toute pièce ne
  // relevant pas d'un "type" catégorisable (cf. StepDossier.tsx).
  nombrePieces           Int?              @map("nombre_pieces")
  autresPieces           String?           @map("autres_pieces") @db.Text

  // --- TITULAIRE (fiche CG1020) ---
  nom       String?
  prenoms   String?
  adresse   String? @db.Text
  telephone String?
  email     String?

  // --- CONTACT (fiche CG1020) ---
  personneContact String? @map("personne_contact")
  mobile          String?

  // --- SUIVI APPLICATIF (ajouté pour la gestion du processus métier) ---
  statutCollecte        StatutCollecte        @default(BROUILLON) @map("statut_collecte")
  statutValidation      StatutValidation      @default(EN_ATTENTE) @map("statut_validation")
  // Phase 20+ : étape "Préparation", intercalée entre Validation et
  // Numérisation — voir le commentaire sur l'enum StatutPreparation.
  statutPreparation     StatutPreparation     @default(EN_ATTENTE) @map("statut_preparation")
  statutNumerisation    StatutNumerisation    @default(EN_ATTENTE) @map("statut_numerisation")
  statutConditionnement StatutConditionnement @default(EN_ATTENTE) @map("statut_conditionnement")
  statutIndexation      StatutIndexation      @default(EN_ATTENTE) @map("statut_indexation")
  statutArchivage       StatutArchivage       @default(EN_ATTENTE) @map("statut_archivage")

  dateSoumission              DateTime? @map("date_soumission")
  dateValidation              DateTime? @map("date_validation")
  datePreparation             DateTime? @map("date_preparation")
  // Agent ayant renseigné la dernière préparation. Il est volontairement
  // distinct de `operateurId`, qui reste l'auteur de l'inventaire initial.
  preparateurId               Int?      @map("preparateur_id")
  preparationClaimedAt        DateTime? @map("preparation_claimed_at")
  dateSoumissionPreparation   DateTime? @map("date_soumission_preparation")
  observationsPreparation     String?   @map("observations_preparation") @db.Text
  dateNumerisation            DateTime? @map("date_numerisation")
  conditionneurId             Int?      @map("conditionneur_id")
  conditionnementClaimedAt    DateTime? @map("conditionnement_claimed_at")
  dateConditionnement         DateTime? @map("date_conditionnement")
  observationsConditionnement String?   @map("observations_conditionnement") @db.Text
  dateIndexation              DateTime? @map("date_indexation")
  dateArchivage               DateTime? @map("date_archivage")

  nombrePages  Int?
  observations String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  operateur                 Operateur                  @relation(fields: [operateurId], references: [id])
  carton                    Carton?                    @relation(fields: [cartonId], references: [id], onDelete: Restrict)
  preparateur               User?                      @relation("DossierPreparateur", fields: [preparateurId], references: [id], onDelete: SetNull)
  conditionneur             User?                      @relation("DossierConditionneur", fields: [conditionneurId], references: [id], onDelete: SetNull)
  reconditionnementSessions ReconditionnementSession[]
  site                      Site?                      @relation(fields: [siteId], references: [id])
  entrepot                  Entrepot?                  @relation(fields: [entrepotId], references: [id])
  commune                   Commune?                   @relation(fields: [communeId], references: [id])
  lotissement               Lotissement?               @relation(fields: [lotissementId], references: [id])
  natureDossier             NatureDossier?             @relation(fields: [natureDossierId], references: [id])
  typesPieces               TypePiece[]                @relation("DossierTypesPieces")
  preparationPieceLines     PreparationPieceLine[]

  documents           Document[]
  numerisations       Numerisation[]
  indexations         Indexation[]
  archivages          Archivage[]
  qualityChecks       QualityCheck[]
  anomalies           Anomalie[]
  workflowTransitions WorkflowTransition[]
  history             DossierHistory[]
  transferLotDossiers TransferLotDossier[]

  @@index([siteId])
  @@index([entrepotId])
  @@index([codeBarres])
  @@index([cartonId])
  @@index([numeroDdu])
  @@index([numeroDirectionService])
  @@index([numeroGuichet])
  @@index([referenceClassement])
  @@index([numeroIlot])
  @@index([numeroLot])
  @@index([numeroTitreFoncier])
  @@index([communeId])
  @@index([lotissementId])
  @@index([natureDossierId])
  @@index([operateurId])
  @@index([preparateurId])
  @@index([conditionneurId])
  @@index([statutCollecte])
  @@index([statutValidation])
  @@index([statutPreparation])
  @@index([statutNumerisation])
  @@index([statutConditionnement])
  @@index([statutIndexation])
  @@index([statutArchivage])
  @@index([createdAt])
  @@index([communeId, statutArchivage])
  @@index([operateurId, statutValidation])
  @@map("dossiers")
}

// Ventilation contrôlée de la préparation. Les totaux du dossier sont
// dérivés de ces lignes : chaque type indique combien de pièces physiques
// et combien de pages ont été constatées. Le préparateur est conservé sur
// chaque ligne pour que les corrections ultérieures restent auditables.
model PreparationPieceLine {
  id           Int      @id @default(autoincrement())
  dossierId    Int      @map("dossier_id")
  typePieceId  Int      @map("type_piece_id")
  nombrePieces Int      @map("nombre_pieces")
  nombrePages  Int      @map("nombre_pages")
  preparedById Int      @map("prepared_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  dossier    Dossier   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  typePiece  TypePiece @relation(fields: [typePieceId], references: [id])
  preparedBy User      @relation("PreparationPieceLinePreparedBy", fields: [preparedById], references: [id])

  @@unique([dossierId, typePieceId])
  @@index([typePieceId])
  @@index([preparedById])
  @@map("preparation_piece_lines")
}

// ================================================================
// DOCUMENTS
// ================================================================

enum StorageProvider {
  LOCAL
  CPANEL
  S3
  SHAREPOINT
  OTHER
}

enum DocumentPreIndexStatus {
  A_TRAITER
  BROUILLON
  PRET
}

enum AutomaticIndexStatus {
  A_TRAITER
  EN_FILE
  EN_COURS
  DEUXIEME_LECTURE
  A_REQUALIFIER
  INDEXE
  ERREUR
}

enum IndexingJobStatus {
  EN_ATTENTE
  EN_COURS
  TERMINE
  ERREUR
  ANNULE
}

enum IndexingPass {
  PRINCIPALE
  SECONDE_LECTURE
}

enum DocumentDerivativeKind {
  PDFA_OCR
}

enum IndexingFieldDataType {
  TEXT
  DATE
  NUMBER
  IDENTIFIER
}

enum IndexValueSource {
  OCR
  DOSSIER
  MANUAL
}

enum DigitalArchiveStatus {
  NON_REQUIS
  EN_ATTENTE
  EN_COURS
  ARCHIVE
  ERREUR
}

model Document {
  id                      Int                    @id @default(autoincrement())
  dossierId               Int                    @map("dossier_id")
  nomFichier              String                 @map("nom_fichier")
  nomOriginal             String                 @map("nom_original")
  typeMime                String                 @map("type_mime")
  extension               String
  taille                  Int // octets
  url                     String                 @db.Text
  storageProvider         StorageProvider        @default(LOCAL) @map("storage_provider")
  hash                    String?
  nombrePages             Int?                   @map("nombre_pages")
  preIndexStatus          DocumentPreIndexStatus @default(A_TRAITER) @map("preindex_status")
  titreIndexation         String?                @map("titre_indexation")
  referenceIndexation     String?                @map("reference_indexation")
  dateDocument            DateTime?              @map("date_document")
  preIndexNotes           String?                @map("preindex_notes") @db.Text
  typePieceId             Int?                   @map("type_piece_id")
  preIndexedBy            Int?                   @map("preindexed_by")
  preIndexedAt            DateTime?              @map("preindexed_at")
  automaticIndexStatus    AutomaticIndexStatus   @default(A_TRAITER) @map("automatic_index_status")
  extractedText           String?                @map("extracted_text") @db.LongText
  searchText              String?                @map("search_text") @db.LongText
  indexingConfidence      Decimal?               @map("indexing_confidence") @db.Decimal(5, 2)
  classificationPath      String?                @map("classification_path") @db.Text
  indexedAt               DateTime?              @map("indexed_at")
  lastIndexingError       String?                @map("last_indexing_error") @db.Text
  externalDriveId         String?                @map("external_drive_id")
  externalItemId          String?                @map("external_item_id")
  externalWebUrl          String?                @map("external_web_url") @db.Text
  digitalArchiveStatus    DigitalArchiveStatus   @default(NON_REQUIS) @map("digital_archive_status")
  alfrescoNodeId          String?                @unique @map("alfresco_node_id")
  alfrescoWebUrl          String?                @map("alfresco_web_url") @db.Text
  alfrescoArchivedAt      DateTime?              @map("alfresco_archived_at")
  alfrescoArchiveError    String?                @map("alfresco_archive_error") @db.Text
  alfrescoArchiveAttempts Int                    @default(0) @map("alfresco_archive_attempts")
  lastArchiveAttemptAt    DateTime?              @map("last_archive_attempt_at")
  uploadedBy              Int?                   @map("uploaded_by")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  dossier      Dossier               @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  uploader     User?                 @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id])
  preIndexer   User?                 @relation("DocumentPreIndexedBy", fields: [preIndexedBy], references: [id])
  typePiece    TypePiece?            @relation(fields: [typePieceId], references: [id])
  indexValues  DocumentIndexValue[]
  indexingRuns DocumentIndexingRun[]
  indexingJobs DocumentIndexingJob[]
  derivatives  DocumentDerivative[]

  @@unique([externalDriveId, externalItemId])
  @@index([dossierId])
  @@index([hash])
  @@index([preIndexStatus])
  @@index([digitalArchiveStatus])
  @@index([typePieceId])
  @@index([preIndexedBy])
  @@index([automaticIndexStatus])
  @@map("documents")
}

model IndexingField {
  id           Int                   @id @default(autoincrement())
  key          String                @unique
  label        String
  aliases      Json
  dataType     IndexingFieldDataType @default(TEXT) @map("data_type")
  isRequired   Boolean               @default(false) @map("is_required")
  isSearchable Boolean               @default(true) @map("is_searchable")
  isActive     Boolean               @default(true) @map("is_active")
  sortOrder    Int                   @default(0) @map("sort_order")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  values DocumentIndexValue[]

  @@index([isActive, sortOrder])
  @@map("indexing_fields")
}

model DocumentIndexValue {
  id         Int              @id @default(autoincrement())
  documentId Int              @map("document_id")
  fieldId    Int              @map("field_id")
  value      String           @db.Text
  rawValue   String?          @map("raw_value") @db.Text
  confidence Decimal?         @db.Decimal(5, 2)
  source     IndexValueSource @default(OCR)
  validated  Boolean          @default(false)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  field    IndexingField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([documentId, fieldId])
  @@index([fieldId, value(length: 191)])
  @@map("document_index_values")
}

model DocumentIndexingRun {
  id                Int                  @id @default(autoincrement())
  documentId        Int                  @map("document_id")
  triggeredBy       Int?                 @map("triggered_by")
  status            AutomaticIndexStatus @default(EN_COURS)
  engine            String
  extractedFields   Json?                @map("extracted_fields")
  extractedTextSize Int?                 @map("extracted_text_size")
  confidence        Decimal?             @db.Decimal(5, 2)
  error             String?              @db.Text
  startedAt         DateTime             @default(now()) @map("started_at")
  completedAt       DateTime?            @map("completed_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("DocumentIndexingRunBy", fields: [triggeredBy], references: [id], onDelete: SetNull)

  @@index([documentId, startedAt])
  @@index([status])
  @@map("document_indexing_runs")
}

model DocumentIndexingJob {
  id           Int               @id @default(autoincrement())
  documentId   Int               @map("document_id")
  requestedBy  Int?              @map("requested_by")
  status       IndexingJobStatus @default(EN_ATTENTE)
  analysisPass IndexingPass      @default(PRINCIPALE) @map("analysis_pass")
  attempts     Int               @default(0)
  maxAttempts  Int               @default(3) @map("max_attempts")
  availableAt  DateTime          @default(now()) @map("available_at")
  lockedAt     DateTime?         @map("locked_at")
  workerId     String?           @map("worker_id")
  error        String?           @db.Text
  completedAt  DateTime?         @map("completed_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requester User?    @relation("DocumentIndexingJobRequestedBy", fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([status, availableAt, createdAt])
  @@index([documentId, status])
  @@map("document_indexing_jobs")
}

model DocumentDerivative {
  id              Int                    @id @default(autoincrement())
  documentId      Int                    @map("document_id")
  kind            DocumentDerivativeKind
  storageProvider StorageProvider        @default(LOCAL) @map("storage_provider")
  storageKey      String                 @map("storage_key")
  url             String                 @db.Text
  mimeType        String                 @map("mime_type")
  size            Int
  hash            String
  externalDriveId String?                @map("external_drive_id")
  externalItemId  String?                @map("external_item_id")
  externalWebUrl  String?                @map("external_web_url") @db.Text
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, kind])
  @@index([hash])
  @@map("document_derivatives")
}

// ================================================================
// NUMÉRISATION / INDEXATION / ARCHIVAGE (historique des opérations)
// ================================================================

enum OperationStatut {
  EN_COURS
  TERMINEE
  ANNULEE
}

enum NiveauQualite {
  BONNE
  MOYENNE
  FAIBLE
}

/**
 * État physique constaté du carton / du dossier à la collecte (Phase 15+).
 */
enum EtatConservation {
  BON_ETAT
  DEGRADE
}

model Numerisation {
  id          Int             @id @default(autoincrement())
  dossierId   Int             @map("dossier_id")
  operateurId Int?            @map("operateur_id")
  dateDebut   DateTime?       @map("date_debut")
  dateFin     DateTime?       @map("date_fin")
  nombrePages Int?            @map("nombre_pages")
  statut      OperationStatut @default(EN_COURS)
  qualite     NiveauQualite?
  commentaire String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  operateur Operateur? @relation(fields: [operateurId], references: [id])

  @@index([dossierId])
  @@index([operateurId])
  @@map("numerisations")
}

model Indexation {
  id           Int             @id @default(autoincrement())
  dossierId    Int             @map("dossier_id")
  operateurId  Int?            @map("operateur_id")
  dateDebut    DateTime?       @map("date_debut")
  dateFin      DateTime?       @map("date_fin")
  statut       OperationStatut @default(EN_COURS)
  scoreQualite Int?            @map("score_qualite") // 0-100
  commentaire  String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  operateur Operateur? @relation(fields: [operateurId], references: [id])

  @@index([dossierId])
  @@index([operateurId])
  @@map("indexations")
}

model Archivage {
  id                 Int             @id @default(autoincrement())
  dossierId          Int             @map("dossier_id")
  operateurId        Int?            @map("operateur_id")
  dateArchivage      DateTime?       @map("date_archivage")
  emplacement        String?
  referenceArchivage String?         @map("reference_archivage")
  statut             OperationStatut @default(EN_COURS)
  commentaire        String?         @db.Text
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  operateur Operateur? @relation(fields: [operateurId], references: [id])

  @@index([dossierId])
  @@index([operateurId])
  @@map("archivages")
}

// ================================================================
// CONTRÔLE QUALITÉ / ANOMALIES
// ================================================================

enum QualityCheckStatut {
  CONFORME
  NON_CONFORME
  A_CORRIGER
}

model QualityCheck {
  id              Int                @id @default(autoincrement())
  dossierId       Int                @map("dossier_id")
  userId          Int?               @map("user_id")
  typeControle    String             @map("type_controle")
  score           Int? // 0-100
  statut          QualityCheckStatut
  nombreAnomalies Int                @default(0) @map("nombre_anomalies")
  commentaire     String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])
  anomalies Anomalie[]

  @@index([dossierId])
  @@index([userId])
  @@map("quality_checks")
}

enum AnomalieType {
  CHAMP_MANQUANT
  DOUBLON
  FORMAT_INVALIDE
  INCOHERENCE
  ERREUR_SAISIE
  DOCUMENT_MANQUANT
  AUTRE
}

enum AnomalieGravite {
  FAIBLE
  MOYENNE
  ELEVEE
  CRITIQUE
}

enum AnomalieStatut {
  OUVERTE
  EN_COURS
  CORRIGEE
  IGNOREE
}

model Anomalie {
  id             Int             @id @default(autoincrement())
  dossierId      Int             @map("dossier_id")
  qualityCheckId Int?            @map("quality_check_id")
  type           AnomalieType
  champ          String?
  description    String?         @db.Text
  gravite        AnomalieGravite
  statut         AnomalieStatut  @default(OUVERTE)
  corrigePar     Int?            @map("corrige_par")
  corrigeLe      DateTime?       @map("corrige_le")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  dossier      Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  qualityCheck QualityCheck? @relation(fields: [qualityCheckId], references: [id])
  correcteur   User?         @relation("AnomalieCorrigePar", fields: [corrigePar], references: [id])

  @@index([dossierId])
  @@index([qualityCheckId])
  @@index([gravite])
  @@index([statut])
  @@map("anomalies")
}

// ================================================================
// IMPORT / EXPORT
// ================================================================

enum ImportFileType {
  CSV
  XLSX
}

enum ImportStatut {
  EN_COURS
  TERMINE
  ECHEC
  ANNULE
}

model Import {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  nomFichier      String         @map("nom_fichier")
  typeFichier     ImportFileType @map("type_fichier")
  nombreLignes    Int?           @map("nombre_lignes")
  nombreValides   Int?           @map("nombre_valides")
  nombreInvalides Int?           @map("nombre_invalides")
  nombreDoublons  Int?           @map("nombre_doublons")
  nombreImportes  Int?           @map("nombre_importes")
  statut          ImportStatut   @default(EN_COURS)
  erreurs         Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  completedAt     DateTime?      @map("completed_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("imports")
}

model Export {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  typeExport   String   @map("type_export")
  filtres      Json?
  nombreLignes Int?     @map("nombre_lignes")
  fichier      String?
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("exports")
}

// ================================================================
// AUDIT / NOTIFICATIONS / PARAMÈTRES
// ================================================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String
  entity    String
  entityId  Int?     @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  type      String
  titre     String
  message   String    @db.Text
  isRead    Boolean   @default(false) @map("is_read")
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String?  @db.Text // JSON sérialisé si nécessaire
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// Diffusion contrôlée des indicateurs de pilotage. Une seule configuration
// est autorisée par destinataire afin d'éviter les envois concurrents ou
// contradictoires pour un même compte.
model EmailReportSubscription {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique @map("user_id")
  frequency     String    @default("WEEKLY") @db.VarChar(16)
  dayOfWeek     Int       @default(1) @map("day_of_week")
  dayOfMonth    Int       @default(1) @map("day_of_month")
  hourUtc       Int       @default(7) @map("hour_utc")
  includePoints Boolean   @default(true) @map("include_points")
  isActive      Boolean   @default(true) @map("is_active")
  nextSendAt    DateTime  @map("next_send_at")
  lastSentAt    DateTime? @map("last_sent_at")
  createdById   Int       @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user       User                  @relation("EmailReportRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User                  @relation("EmailReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  deliveries EmailReportDelivery[]

  @@index([isActive, nextSendAt])
  @@map("email_report_subscriptions")
}

model EmailReportDelivery {
  id                Int       @id @default(autoincrement())
  subscriptionId    Int       @map("subscription_id")
  recipientUserId   Int       @map("recipient_user_id")
  triggeredById     Int?      @map("triggered_by_id")
  triggerType       String    @map("trigger_type") @db.VarChar(16)
  scheduledFor      DateTime  @map("scheduled_for")
  idempotencyKey    String    @unique @map("idempotency_key") @db.VarChar(191)
  status            String    @default("PENDING") @db.VarChar(16)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(191)
  errorMessage      String?   @map("error_message") @db.Text
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  subscription EmailReportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  recipient    User                    @relation("EmailReportDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  triggeredBy  User?                   @relation("EmailReportDeliveryTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([status, createdAt])
  @@map("email_report_deliveries")
}

// Journal des alertes transactionnelles du circuit de transfert. Une cle
// d'idempotence unique empeche qu'une reprise d'action envoie deux fois le
// meme jalon au meme destinataire.
model TransferEmailDelivery {
  id                Int       @id @default(autoincrement())
  recipientUserId   Int       @map("recipient_user_id")
  eventType         String    @map("event_type") @db.VarChar(48)
  entityType        String    @map("entity_type") @db.VarChar(32)
  entityId          Int       @map("entity_id")
  idempotencyKey    String    @unique @map("idempotency_key") @db.VarChar(191)
  payload           Json
  status            String    @default("PENDING") @db.VarChar(16)
  attemptCount      Int       @default(0) @map("attempt_count")
  nextAttemptAt     DateTime? @default(now()) @map("next_attempt_at")
  lastAttemptAt     DateTime? @map("last_attempt_at")
  providerMessageId String?   @map("provider_message_id") @db.VarChar(191)
  errorMessage      String?   @map("error_message") @db.Text
  sentAt            DateTime? @map("sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  recipient User @relation("TransferEmailDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([recipientUserId, createdAt])
  @@index([eventType, entityType, entityId])
  @@index([status, nextAttemptAt])
  @@map("transfer_email_deliveries")
}

// Temps passé par un agent sur un dossier lors du reconditionnement. Plusieurs
// agents peuvent travailler sur le même carton : chacun prend un dossier à la
// fois, le chrono démarre à « Commencer » et s'arrête quand il répond à la
// question de fin. Un dossier libéré ou repris garde sa session, fermée.
model ReconditionnementSession {
  id              Int                @id @default(autoincrement())
  dossierId       Int                @map("dossier_id")
  userId          Int                @map("user_id")
  startedAt       DateTime           @default(now()) @map("started_at")
  finishedAt      DateTime?          @map("finished_at")
  durationSeconds Int?               @map("duration_seconds")
  // null tant que la session est ouverte ; renseigné à la fin.
  etatRemise      EtatRemiseDossier? @map("etat_remise")
  abandoned       Boolean            @default(false)
  observations    String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([dossierId])
  @@index([userId, finishedAt])
  @@map("reconditionnement_sessions")
}
